{
  "name": "printfarm",
  "private": true,
  "version": "1.0.0",
  "description": "Print Farm Management System",
  "author": "PrintFarm Team",
  "main": "../electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron": "electron ../electron/main.js --no-sandbox",
    "electron:dev": "cross-env NODE_ENV=development concurrently \"pnpm dev\" \"wait-on http://localhost:5173 && electron ../electron/main.js --no-sandbox\"",
    "electron:build": "pnpm build && electron-builder",
    "electron:build:linux": "pnpm build && electron-builder --linux",
    "electron:build:win": "pnpm build && electron-builder --win",
    "electron:build:mac": "pnpm build && electron-builder --mac"
  },
  "build": {
    "appId": "com.printfarm.app",
    "productName": "PrintFarm",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "../electron/**/*",
      "../backend/**/*",
      "!../backend/**/__pycache__",
      "!../backend/**/*.pyc",
      "!../backend/venv",
      "!../backend/.venv"
    ],
    "extraResources": [
      {
        "from": "../backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!**/__pycache__",
          "!**/*.pyc",
          "!venv",
          "!.venv"
        ]
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities"
    }
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.17",
    "@tanstack/react-query": "^5.90.7",
    "@tanstack/react-query-devtools": "^5.90.2",
    "@zxing/browser": "^0.1.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.24",
    "lucide-react": "^0.552.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.1.1",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.5",
    "recharts": "^3.3.0",
    "tailwind-merge": "^3.3.1",
    "tailwind-variants": "^3.1.1",
    "tailwindcss": "^4.1.17"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/node": "^24.10.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.45.0",
    "vite": "^7.1.7",
    "wait-on": "^9.0.3"
  }
}
